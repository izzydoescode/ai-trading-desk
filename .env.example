# Copy to .env (git-ignored) and fill in what you have. Exported shell values win.
# Optional if you have signed in with `ant auth login`; the SDK then uses that profile.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Alpaca paper-account keys. When both are set the desk uses Alpaca for prices and news by
# default. They are used to READ market data only; the desk sends no orders to Alpaca.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Backup news feed, used only when Alpaca's news request fails.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
